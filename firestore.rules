rules_version = '2';
// PMBO security rules
// - Public can read everything (it's a public tournament site)
// - Only authenticated users (referees) can write
service cloud.firestore {
  match /databases/{database}/documents {
    // Public read for tournament data
    match /players/{doc}      { allow read: if true; allow write: if request.auth != null; }
    match /venues/{doc}       { allow read: if true; allow write: if request.auth != null; }
    match /games/{doc}        { allow read: if true; allow write: if request.auth != null; }
    match /playerGameStats/{doc} { allow read: if true; allow write: if request.auth != null; }

    // User profiles: user can read/write own
    match /users/{userId} {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
